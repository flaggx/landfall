# Example secrets file — DO NOT commit real values.
# Managed via: vpsdeploy secrets set <name>
# Location:   ~/.config/vpsdeploy/secrets.toml

[secrets]
prod_db_url = "postgresql://user:pass@localhost:5432/mydb"
prod_redis_url = "redis://my_webapp_prod:password@127.0.0.1:6379/0"
dev_db_url = "postgresql://user:pass@localhost:5432/mydb_dev"
dev_redis_url = "redis://my_webapp_dev:password@127.0.0.1:6379/1"
